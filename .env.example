# Telegram bot tokeni (@BotFather beradi)
BOT_TOKEN=

# O'zingiz o'ylab topgan uzun tasodifiy matn (faqat harf, raqam, _ va -)
WEBHOOK_SECRET=

# Postgres (Vercel Storage -> Neon ulasangiz o'zi qo'shiladi)
DATABASE_URL=

# Vercel Blob (rasm/video uchun; Vercel Storage -> Blob ulasangiz o'zi qo'shiladi)
BLOB_READ_WRITE_TOKEN=

# Ixtiyoriy: faqat shu Telegram ID'lar ishlata oladi (vergul bilan). Bo'sh qolsa hamma ishlata oladi,
# lekin har kim faqat o'z joylarini ko'radi.
ALLOWED_USER_IDS=

# Ixtiyoriy: ilovaning to'liq manzili, masalan https://baliq-ovi.vercel.app
APP_URL=
